# --- X Share API (server: npm run dev:share-server) ---
# Create an app at https://developer.x.com with OAuth 2.0 User authentication.
# Register this EXACT callback URL in the X Developer Portal:
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=http://localhost:8080/api/x-share/auth/x/callback
X_SHARE_FRONTEND_ORIGIN=http://localhost:8080
X_SHARE_SESSION_SECRET=replace-with-long-random-string
X_SHARE_PORT=8788
# X_TOKEN_STORE_PATH=.data/x-share-tokens.json
# X_GOVERNANCE_SHARE_STORE_PATH=.data/governance-shares
# X_GOVERNANCE_SHARE_TTL_DAYS=90
# Public base for share permalinks (tweets + og:image). Dev default uses Vite proxy:
# X_SHARE_PUBLIC_BASE=http://localhost:8080/api/x-share

# --- Frontend (optional) ---
# Defaults to /api/x-share via Vite dev proxy
# VITE_X_SHARE_API_BASE=/api/x-share
# VITE_X_SHARE_LOCAL_TARGET=http://127.0.0.1:8788
