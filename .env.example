# =============================================================================
# Haystack Order Router — server-only secrets
# =============================================================================
# NEVER prefix with VITE_ (Vite would embed the value in the browser bundle).
# NEVER set HAYSTACK_API_KEY in the static SPA / frontend CI build env.

HAYSTACK_API_KEY=

# Optional override (default https://hayrouter.txnlab.dev)
# HAYSTACK_API_BASE=

# -----------------------------------------------------------------------------
# Standalone proxy: npm run haystack-proxy
# Required for beta/production when the SPA is a static host (no Vite middleware).
# -----------------------------------------------------------------------------
# HAYSTACK_PROXY_PORT=8791
# Local default binds 127.0.0.1. For a public deploy host use 0.0.0.0:
# HAYSTACK_PROXY_HOST=0.0.0.0
# Required when HOST is not loopback (comma-separated, no trailing slash):
# HAYSTACK_PROXY_CORS_ORIGINS=https://beta.dork.fi,https://app.dork.fi

# =============================================================================
# Client (VITE_*) — safe for the browser bundle; no API secrets here
# =============================================================================

# Cross-asset repay UI. Local: set true below. Production builds use
# `.env.production` (VITE_ENABLE_CROSS_ASSET_REPAY=true). Kill-switch: false.
# DEV defaults on when unset. beta.dork.fi also auto-enables when unset.
VITE_ENABLE_CROSS_ASSET_REPAY=true

# Absolute origin of the deployed Haystack key proxy (no trailing slash).
# Dev default is /api/haystack (Vite middleware injects HAYSTACK_API_KEY).
# Production builds fall back to the baked Railway proxy when unset.
# VITE_HAYSTACK_PROXY_URL=https://profound-bravery-production-418a.up.railway.app

# =============================================================================
# Repay / Borrow share server (OG / X link preview) — npm run dev:share-server
# =============================================================================
# X_SHARE_FRONTEND_ORIGIN=http://localhost:8080
# X_SHARE_PORT=8788
# Public permalink base (dev uses Vite proxy):
# X_SHARE_PUBLIC_BASE=http://localhost:8080/api/x-share
# X_REPAY_SHARE_STORE_PATH=.data/repay-shares
# X_BORROW_SHARE_STORE_PATH=.data/borrow-shares
# X_REPAY_SHARE_TTL_DAYS=90
# X_BORROW_SHARE_TTL_DAYS=90

# Production (Railway):
# X_SHARE_FRONTEND_ORIGIN=https://app.dork.fi
# X_SHARE_PUBLIC_BASE is auto-set from RAILWAY_PUBLIC_DOMAIN when deployed.
#
# IMPORTANT (X link-preview cards): X suppresses cards for shared free-hosting
# domains like *.up.railway.app, so the auto-set RAILWAY_PUBLIC_DOMAIN value will
# validate fine yet still render as a plain link on X. Use a custom domain and set
# X_SHARE_PUBLIC_BASE explicitly so og:url/og:image are served from it:
# X_SHARE_PUBLIC_BASE=https://share.dork.fi
#
# Frontend production default is X_SHARE_API_DEFAULT_ORIGIN in xShareService.ts.
# Point it at the same custom domain so the POST + tweet URL use it too:
# VITE_X_SHARE_API_BASE=https://share.dork.fi
# VITE_X_SHARE_LOCAL_TARGET=http://127.0.0.1:8788

# =============================================================================
# Long/Short live chart price feed (display only — NOT settlement)
# =============================================================================
# Defaults to Coinbase Exchange public REST/WebSocket (no API key).
# Swap these to point at another provider behind AssetPriceFeedProvider.
# VITE_LONGSHORT_PRICE_REST_URL=https://api.exchange.coinbase.com
# VITE_LONGSHORT_PRICE_WS_URL=wss://ws-feed.exchange.coinbase.com
