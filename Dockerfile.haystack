# Minimal image for scripts/haystack-proxy.mjs (Node builtins only — no npm/bun install).
# Railway: Settings → Build → Dockerfile path = Dockerfile.haystack
#   or Config-as-code → railway.haystack.toml
FROM node:22-alpine
WORKDIR /app
COPY scripts/haystack-proxy.mjs ./scripts/haystack-proxy.mjs
ENV HAYSTACK_PROXY_HOST=0.0.0.0
# Railway injects PORT; the script already reads process.env.PORT
CMD ["node", "scripts/haystack-proxy.mjs"]
